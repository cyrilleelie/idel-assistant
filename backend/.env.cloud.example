# .env.cloud — Configuration cloud (itération C), à conserver comme fallback
# Copier en .env pour revenir au mode cloud

# Providers cloud
LLM_PROVIDER=mistral_cloud
LLM_MODEL_NAME=mistral-large-latest
STT_PROVIDER=whisper_cloud
TTS_PROVIDER=elevenlabs

# Clés API cloud
MISTRAL_API_KEY=votre_cle_mistral
OPENAI_API_KEY=votre_cle_openai
ELEVENLABS_API_KEY=votre_cle_elevenlabs
ELEVENLABS_VOICE_ID=charlotte

# Les variables GPU ne sont plus nécessaires en mode cloud
# GPU_BASE_URL=
# VLLM_BASE_URL=
# WHISPER_LOCAL_URL=
# KOKORO_LOCAL_URL=
# LORA_MODEL_NAME=
