# Copier en .env et renseigner les valeurs (jamais commiter .env)

# --- Base de données & cache ---
DATABASE_URL=postgresql+asyncpg://idel:idel_dev@localhost:5432/idel_db
DATABASE_URL_SYNC=postgresql://idel:idel_dev@localhost:5432/idel_db
REDIS_URL=redis://localhost:6379/0

# --- Sécurité ---
# SECRET_KEY : chaîne aléatoire longue (JWT signing)
SECRET_KEY=change-me
# ENCRYPTION_MASTER_KEY : doit faire exactement 32 octets (AES-256-GCM colonnes patients)
ENCRYPTION_MASTER_KEY=change-me-32-bytes-exactly!!!!!
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Divers ---
OPENROUTESERVICE_API_KEY=
ENVIRONMENT=development
DEBUG=true

# --- Agent IA / LLM ---
MISTRAL_API_KEY=
LLM_PROVIDER=mistral_cloud
LLM_MODEL_NAME=mistral-large-latest
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
AGENT_SESSION_TTL_SECONDS=14400
AGENT_MAX_HISTORY_MESSAGES=20
AGENT_MAX_TOOL_CALLS_PER_REQUEST=10

# --- Agent IA / Voix — cloud (itération C) ---
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=charlotte
TTS_ENABLED=true
STT_PROVIDER=whisper_cloud
TTS_PROVIDER=elevenlabs

# --- Agent IA / GPU self-hosted (itération D) ---
# Voir .env.gpu.example pour la config complète mode GPU
GPU_BASE_URL=
VLLM_BASE_URL=
WHISPER_LOCAL_URL=
KOKORO_LOCAL_URL=

# --- Agent IA / Fine-tuning (itération E) ---
LORA_MODEL_NAME=

# --- Secrétaire médical IA (itération F) ---
RECEPTIONIST_ENABLED=false
RECEPTIONIST_GREETING_DELAY_MS=500
OVH_SMS_APP_KEY=
OVH_SMS_APP_SECRET=
OVH_SMS_CONSUMER_KEY=
OVH_SMS_ACCOUNT=
OVH_SMS_SENDER=Cabinet IDEL
CABINET_SERVICE_TOKEN=
# URL WS que le pont AGI Asterisk (receptionist_bridge.py) appelle
RECEPTIONIST_WS_URL=ws://127.0.0.1:8000/api/v1/receptionist/call

# --- Uploads ---
# Dossier de stockage des ordonnances scannées (relatif au dossier backend/)
PRESCRIPTION_UPLOAD_DIR=uploads/prescriptions
