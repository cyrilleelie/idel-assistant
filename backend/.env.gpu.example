# .env.gpu — Configuration pour le mode GPU self-hosted (itération D)
# Copier en .env sur le serveur applicatif pour activer le mode GPU

# Providers GPU
LLM_PROVIDER=vllm_local
LLM_MODEL_NAME=mistral-small-3.1-awq
STT_PROVIDER=faster_whisper_local
TTS_PROVIDER=kokoro_local

# URL du serveur GPU (réseau privé vRack OVH)
GPU_BASE_URL=http://10.0.0.5:9000

# Les clés cloud ne sont plus nécessaires en mode GPU
# MISTRAL_API_KEY=
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
